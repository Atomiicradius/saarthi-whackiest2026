# Copy to .env and fill in. Never commit .env.
# The API loads it with: cd api && uvicorn main:app --reload --env-file ../.env

# Scheme dataset: the API reads data/schemes.json by default. Set SAARTHI_SCHEMES_PATH only to use another file.
# Comma-separated browser origins allowed to call the API.
SAARTHI_CORS_ORIGINS=http://localhost:3000
# Demo only: pin "today" for closed-window checks. Unset means the real date.
SAARTHI_TODAY=2026-11-24

# Voice proxy. The key stays on the server and never reaches the browser.
ELEVENLABS_API_KEY=your-key-here
# Free plans can only use the default voices through the API, not library voices.
# Example default voice: Sarah.
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_STT_MODEL=scribe_v1
# Speech model for English and Hindi, and a separate one for Kannada (flash cannot speak Kannada).
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_TTS_MODEL_KN=eleven_v3

# Optional for round 1
AWS_ACCESS_KEY_ID=your-key-here
AWS_SECRET_ACCESS_KEY=your-secret-here
AWS_S3_BUCKET=your-bucket-here
