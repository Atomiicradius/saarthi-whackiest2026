# Copy to .env.local. Both default to the safe value if unset.
# Use mock data (true) or call the FastAPI backend (false).
NEXT_PUBLIC_USE_MOCKS=true
# Shows the "Reset to Ravi" button. Demo and dev only.
NEXT_PUBLIC_DEMO_MODE=true
# Base URL of the API when mocks are off. Empty means same origin.
NEXT_PUBLIC_API_BASE_URL=
# Demo only: the date used for every "days left" count when NEXT_PUBLIC_DEMO_MODE=true.
# Defaults to 2026-11-24 if unset.
NEXT_PUBLIC_DEMO_TODAY=2026-11-24
