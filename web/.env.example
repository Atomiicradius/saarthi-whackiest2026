# Copy to .env.local. Unset values fall back to the safe default (mocks on, no demo controls).
# false = use the API at http://localhost:8000 (NEXT_PUBLIC_API_BASE_URL), which must be running. true = built-in sample data. Voice needs the API.
NEXT_PUBLIC_USE_MOCKS=true
# Shows the "Reset to <sample student>" button. Demo and dev only.
NEXT_PUBLIC_DEMO_MODE=true
# Base URL of the API (run it with: cd api && uvicorn main:app --env-file ../.env).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Demo only: the date used for every "days left" count when NEXT_PUBLIC_DEMO_MODE=true.
# Defaults to 2026-11-24 if unset.
NEXT_PUBLIC_DEMO_TODAY=2026-11-24
